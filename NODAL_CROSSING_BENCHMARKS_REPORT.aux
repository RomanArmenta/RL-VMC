\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Figura 4.1: Densidades electrónicas de un cuerpo resueltas por espín $\rho _\uparrow (x)$ y $\rho _\downarrow (x)$ frente a la referencia CASSCF congelada. MALA clásico permanece polarizado asimétricamente en los pozos exteriores e interiores, mientras que RL-MALA restaura la indistinguibilidad estadística exacta.}}{7}{figure.caption.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Reconstrucción de Densidades Espaciales y Simetría de Espín Exacta}{7}{figure.caption.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Figura 4.2: Trazas temporales para un único caminante físico en $40,000$ pasos de evaluación. MALA queda atrapado en una configuración de espín ordenada ($x_{1,\uparrow } < x_{2,\uparrow } < 0 < x_{1,\downarrow } < x_{2,\downarrow }$), mientras que RL-MALA atraviesa repetidamente las barreras de intercambio sin sufrir colapso de aceptación.}}{8}{figure.caption.7}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Dinámica Individual de Cruce Nodal (Trazas de 1 Caminante)}{8}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Figura 4.3: Evolución de las métricas clave ($D_{\mathrm  {KL}}^{\mathrm  {spin}}$, salto cuadrático $\mathrm  {ESJD}$, tiempo de autocorrelación $\tau _{\mathrm  {int}}(E)$ y tasa de aceptación) en función del paso temporal $\tau $. Las curvas sólidas (RL-MALA) muestran la media y la dispersión sobre todas las combinaciones de $(A_\mu , \lambda _{\mathrm  {pen}})$; las curvas punteadas representan MALA.}}{9}{figure.caption.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Figura 4.4: Mapas de calor 2D para la divergencia de espín $D_{\mathrm  {KL}}^{\mathrm  {spin}}$ y el salto $\mathrm  {ESJD}$ en el plano $(A_\mu , \tau )$ para penalizaciones $\lambda _{\mathrm  {pen}} \in \{0.20, 0.30, 0.40\}$. Se evidencia la meseta óptima en $\tau =0.14, A_\mu \in [0.06, 0.12]$.}}{10}{figure.caption.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Figura 4.5: Análisis de sensibilidad del error de simetría $D_{\mathrm  {KL}}^{\mathrm  {spin}}$ frente al parámetro de penalización de rechazo $\lambda _{\mathrm  {pen}}$ para distintos niveles de $\tau $.}}{10}{figure.caption.11}\protected@file@percent }
