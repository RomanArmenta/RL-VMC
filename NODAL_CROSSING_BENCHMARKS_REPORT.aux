\@writefile{toc}{\contentsline {paragraph}{Evolución de Flips respecto a $g$ para $N=4$ Electrones (\texttt  {c0-a4, b=32})}{24}{figure.caption.36}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Figura 9.4: Caracterización en $N=6, g=0.5$ ($d_{\mathrm  {adj}} = 3.84\text  { Bohr}$). RL-MALA alcanza $32.60\text  { flips}/1\text  {k}$ frente a $0.86\text  { flips}/1\text  {k}$ de MALA ($37.9\times $), ejecutando el $65.2\%$ de los intercambios en un único paso colectivo MCMC.}}{25}{figure.caption.38}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Figura 9.5: Caracterización en $N=6, g=1.0$ ($d_{\mathrm  {adj}} = 4.40\text  { Bohr}$). En el panel (a), MALA presenta sólo $0.44\text  { flips}/1\text  {k}$ y mantiene los espines segregados, mientras que RL-MALA alcanza $18.78\text  { flips}/1\text  {k}$ ($56.4\%$ en 1 paso) y mezcla uniformemente los 6 pozos de Wigner.}}{26}{figure.caption.39}\protected@file@percent }
