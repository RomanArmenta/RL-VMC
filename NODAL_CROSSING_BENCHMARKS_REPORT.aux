\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Figura 6.1: Frontera de Pareto para todos los modelos evaluados en $N=4$ y $N=6$. El panel izquierdo grafica $\mathrm  {ESJD}$ frente a la tasa de aceptación; el panel derecho ilustra la divergencia de espín $D_{\mathrm  {KL}}^{\mathrm  {spin}}$ frente al tiempo de autocorrelación $\tau _{\mathrm  {int}}(E)$. RL-MALA rompe el límite difusivo clásico de MALA, logrando saltos $\mathrm  {ESJD} > 2.0\text  { Bohr}^2$ con aceptaciones estables del $33\%-45\%$.}}{18}{figure.caption.23}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Frontera de Pareto: Compensación entre Movilidad y Tasa de Aceptación}{18}{figure.caption.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Figura 6.2: Comparación directa entre los mejores modelos MALA y RL-MALA para $N=4$ y $N=6$ en escala logarítmica para $D_{\mathrm  {KL}}^{\mathrm  {spin}}$, $\mathrm  {ESJD}$, $\tau _{\mathrm  {int}}(E)$ y tasa de aceptación. Se aprecia la reducción de 2 a 4 órdenes de magnitud en la asimetría de espín.}}{18}{figure.caption.25}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Comparación Global de Cruce Nodal: Mejor MALA vs Mejor RL-MALA}{18}{figure.caption.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Figura 6.3: Visión global de todas las configuraciones evaluadas para $Wigner\_N4\_g4.0$ y $MultiDet\_N6\_g1.0$, contrastando la dispersión de MALA (líneas discontinuas) frente a RL-MALA (líneas sólidas).}}{19}{figure.caption.27}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Visión General Consolidada de Ambos Sistemas}{19}{figure.caption.27}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Figura 6.4: Mapas de calor consolidados en función de la amplitud de red $A_\mu $ y la penalización de rechazo $\lambda _{\mathrm  {pen}}$, demostrando que $A_\mu \in [0.06, 0.12]$ y $\lambda _{\mathrm  {pen}} \ge 0.20$ minimizan uniformemente el error de espín sin degradar la aceptación.}}{19}{figure.caption.29}\protected@file@percent }
